{
    "style": {
        "background": "#121212",
        "color": "#ffffff",
        "font-family": "'Noto Mono', monospace",
        "font-size": "0.75em"
    },
    "htm": "<meta charset='utf-8'><style>body{background:$BACKGROUND;width:100vw;height:100vh;padding:0;margin:0;overflow-y:scroll;overflow-x:clip}#terminal{color:$COLOR;font-size:$FONTSIZE;font-family:$FONTFAMILY;width:95vw;margin-left:2.5vw;margin-top:2.5vw;display:block}</style><p id='terminal'></p><script>window.addEventListener('message',ev=>{if(ev.data&&ev.source===window.parent){const data=JSON.parse(ev.data);if(data.type==='TERMINAL_UPDATED'){document.querySelector('#terminal').innerHTML=atob(data.data);document.body.scrollIntoView(false)}}});</script>",
    "parser": {
        "arch": ["zip","PigeonScript"],
        "name":"ps",
        "broadcast":"pigeonscript:execute",
        "main":"main.ps"
    }
}